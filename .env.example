# ---------------------------------------------------------------------------
# Vibe Budget Agent — example configuration.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# All values below are placeholders, not working secrets.
# ---------------------------------------------------------------------------

# Operating mode: mock | estimate | live
#   mock     — fully local demo, bundled /capabilities snapshot, zero network, zero spend
#   estimate — real GET /capabilities + POST /generate/estimate, execution disabled
#   live     — paid generation, still only after {"confirmed": true}
# Default is "mock". Set "live" deliberately and never in CI.
APP_MODE=mock

APP_ENV=local
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Vibe-Marketolog Agent API -------------------------------------------
VIBE_BASE_URL=https://lk.vibemarketolog.ru/api/agent

# Bearer token from https://lk.vibemarketolog.ru/#agent — required for estimate/live.
# Leave empty in mock mode.
VIBE_API_TOKEN=

# Webhook secret issued together with the token. Required to accept callbacks.
# Unsigned or wrongly signed webhooks are always rejected.
VIBE_WEBHOOK_SECRET=

# Legacy tokens (issued before 2026-07-09) sign with sha256(api_token) instead of
# the dedicated webhook secret. Enable only if your token predates that date.
VIBE_WEBHOOK_LEGACY_FALLBACK=false

# Public URL of this service, used to build callback_url for /generate.
# Leave empty to disable callbacks and rely on polling only.
CALLBACK_BASE_URL=

# --- HTTP / retry / polling ----------------------------------------------
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=30.0
HTTP_TOTAL_TIMEOUT=60.0
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8.0
RETRY_JITTER=0.3
POLL_INTERVAL_SECONDS=10.0
POLL_TIMEOUT_SECONDS=900.0

# --- Background execution -------------------------------------------------
# How many confirmed plans may execute at once. Each job is claimed in the
# database before it runs, so raising this cannot execute a plan twice.
EXECUTOR_CONCURRENCY=2
# How often to re-ask the platform about steps that were paid for but never
# reported back (poll timeout, lost webhook, killed process). 0 disables it.
RECONCILE_INTERVAL_SECONDS=300
# Grace period before a launched step is chased, so a fresh one is left alone.
RECONCILE_MIN_AGE_SECONDS=60

# --- Retention ------------------------------------------------------------
# How often to purge expired replay keys and dead upload links; 0 disables.
RETENTION_INTERVAL_SECONDS=3600
# How long a stored response stays replayable for an Idempotency-Key.
IDEMPOTENCY_TTL_HOURS=24
# Warn while planning when an uploaded link dies within this many days.
UPLOAD_EXPIRY_WARNING_DAYS=2

# --- Budget guardrails ----------------------------------------------------
# Hard ceiling: a request asking for more than this is rejected outright.
MAX_BUDGET_RUB=10000
# Fraction of the budget kept unspent as protection against price drift (0.05 = 5%).
BUDGET_SAFETY_MARGIN=0.05

# --- Storage --------------------------------------------------------------
DB_PATH=./data/vibe_agent.db

# --- Mock-mode account simulation (ignored outside mock) ------------------
MOCK_BALANCE_RUB=5000
MOCK_DAILY_LIMIT_RUB=5000
MOCK_DAILY_SPENT_RUB=0

# --- Model selection policy ----------------------------------------------
# Optional JSON file overriding the built-in priority table (prices always come
# from /capabilities, never from this file).
POLICY_FILE=
